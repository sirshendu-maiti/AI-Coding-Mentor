# ─── Required ─────────────────────────────────────────────
# Get from: https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Firebase Admin SDK — paste the ENTIRE JSON content as a single line
# Get from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"...","private_key":"...","client_email":"..."}

# Firebase Realtime Database URL
# Get from: Firebase Console > Realtime Database > Copy the URL
FIREBASE_DATABASE_URL=https://your-project-id-default-rtdb.firebaseio.com

# ─── Optional ─────────────────────────────────────────────
PORT=3000
NODE_ENV=production

# Rate limiting (requests per window)
RATE_LIMIT_AI_MAX=50
RATE_LIMIT_AI_WINDOW_MINUTES=60
RATE_LIMIT_GLOBAL_MAX=100
RATE_LIMIT_GLOBAL_WINDOW_MINUTES=1
OPENROUTER_API_KEY=
